    {
      "name": "Internal (HMAC)",
      "description": "Service-to-service endpoints secured by HMAC. Set X-Internal-Signature header.",
      "item": [
        {
          "name": "Get Product with Branch Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Internal-Signature", "value": "{{internal_hmac_signature}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/internal/products/{{product_id}}/branch/{{branch_id}}",
